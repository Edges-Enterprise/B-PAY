{
  "expo": {
    "name": "Edges Network",
    "slug": "edges-network",
    "scheme": "edges-network",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.edgesnetwork.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000",
          "resizeMode": "cover",
          "image": "./assets/images/splash-dark.png"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000",
          "resizeMode": "cover",
          "image": "./assets/images/splash-dark.png"
        }
      },
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#8B4513"
      },
      "jsEngine": "hermes",
      "enableProguardInReleaseBuilds": true,
      "package": "com.edgesnetwork.app",
      "googleServicesFile": "./google-services.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c3303360-7e01-48dd-9c1d-a9dff8b12e97"
      }
    },
    "owner": "phoenix-boss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
			"enabled": true,
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0,
			"url": "https://u.expo.dev/c3303360-7e01-48dd-9c1d-a9dff8b12e97"
		}
  }
}
